{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeCoAuthoredBy": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash '__REPO__/hooks/claude/guard-bash.sh' #harness",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '__REPO__/hooks/claude/budget.sh' #harness",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash '__REPO__/hooks/claude/format-file.sh' #harness",
            "timeout": 60,
            "statusMessage": "Formatting"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash '__REPO__/hooks/claude/fast-check.sh' #harness",
            "timeout": 90,
            "statusMessage": "Running the fast check"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash '__REPO__/hooks/claude/stop-check.sh' #harness",
            "timeout": 90
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash '__REPO__/hooks/claude/session-context.sh' #harness",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
