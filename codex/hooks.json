{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash '__REPO__/hooks/claude/guard-bash.sh' --codex #tack",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '__REPO__/hooks/claude/budget.sh' #tack",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "bash '__REPO__/hooks/claude/fast-check.sh' #tack",
            "timeout": 90
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash '__REPO__/hooks/claude/stop-check.sh' --codex #tack",
            "timeout": 90
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash '__REPO__/hooks/claude/session-context.sh' --codex #tack",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
