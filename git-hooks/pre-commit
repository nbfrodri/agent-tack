#!/usr/bin/env bash
# Global pre-commit safety net: run the local hook, then inspect the final index for
# environment files and added lines containing well-known credential formats.
# Reports the file and kind of secret, never the secret itself.
# Deliberate one-off override: TACK_ALLOW_SECRETS=1 git commit ...
set -u

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=SCRIPTDIR/_chain
. "$HOOK_DIR/_chain"

refuse() {
  cat >&2 <<EOF_MESSAGE
pre-commit: refusing to commit secrets:
$1
Keep secrets in .env (git-ignored) or a secret manager, and document the variable in .env.example.
To unstage: git restore --staged <file>. If the secret was ever pushed, rotate it.
(Deliberate override: TACK_ALLOW_SECRETS=1 git commit ...)
EOF_MESSAGE
  exit 1
}

scan_error() {
  echo 'pre-commit: cannot inspect the staged changes; refusing to commit.' >&2
  exit 1
}

run_local_hook pre-commit "$@" || exit $?
if override_set SECRETS; then exit 0; fi

root="$(git rev-parse --show-toplevel)" || scan_error
work="$(mktemp -d "${TMPDIR:-/tmp}/pre-commit.XXXXXX")" || scan_error
trap 'rm -rf "$work"' EXIT

# NUL records and literal pathspecs preserve filenames independently of Git's quoting.
git -C "$root" diff --cached --name-only -z --no-renames --diff-filter=ACMRT > "$work/paths" || scan_error
found=""
while IFS= read -r -d '' path; do
  printf -v display '%q' "$path"
  case "${path##*/}" in
    .env.example | .env.sample | .env.template | .env.dist) ;;
    .env | .env.*) found="$found  $display: environment file
" ;;
  esac

  # Force text so attributes and NUL bytes cannot hide added credentials. Hunk parsing
  # ignores display headers, and disables project diff helpers that can execute code.
  git --literal-pathspecs -C "$root" diff --cached --unified=0 --no-color --no-ext-diff \
    --no-textconv --no-renames --text --word-diff=none --output-indicator-new=+ \
    --output-indicator-old=- --output-indicator-context=' ' -- "$path" > "$work/diff" || scan_error
  LC_ALL=C tr '\000' ' ' < "$work/diff" > "$work/text" || scan_error
  LC_ALL=C awk '/^@@ / { hunk = 1; next } hunk && /^\+/ { print substr($0, 2) }' \
    "$work/text" > "$work/added" || scan_error

  while IFS='|' read -r kind pattern; do
    LC_ALL=C grep -a -E -e "$pattern" "$work/added" > /dev/null
    status=$?
    case "$status" in
      0) found="$found  $display: $kind
" ;;
      1) ;;
      *) scan_error ;;
    esac
  done <<'PATTERNS'
private key|-----BEGIN ([A-Z]+ )?PRIVATE KEY-----
AWS access key|AKIA[0-9A-Z]{16}
GitHub token|gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{22,}
Stripe live key|[sr]k_live_[0-9a-zA-Z]{24,}
Slack token|xox[baprs]-[0-9A-Za-z-]{10,}
Google API key|AIza[0-9A-Za-z_-]{35}
Anthropic API key|sk-ant-[A-Za-z0-9_-]{20,}
OpenAI API key|sk-proj-[A-Za-z0-9_-]{20,}
PATTERNS
done < "$work/paths"

[ -z "$found" ] || refuse "$found"
exit 0
