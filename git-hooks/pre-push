#!/usr/bin/env bash
# Global pre-push hook:
#   - refuses to rewrite or delete main/master on any remote (force pushes, deletions);
#   - in projects where tack is enabled, only lets annotated vX.Y.Z tags (and
#     -alpha.N/-beta.N/-rc.N pre-releases) through, and never moves or deletes a published tag;
#   - then runs the repository's own pre-push hook, if any.
#
# Deliberate one-off overrides:
#   TACK_ALLOW_FORCE_PUSH=1 git push --force ...   (main/master)
#   TACK_ALLOW_TAG=1 git push ...                  (tags)
set -u

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=SCRIPTDIR/_chain
. "$HOOK_DIR/_chain"

remote_name="${1:-remote}"
stdin_file="$(mktemp "${TMPDIR:-/tmp}/pre-push.XXXXXX")" || exit 1
trap 'rm -f "$stdin_file"' EXIT
cat > "$stdin_file"

is_zero() { case "$1" in *[!0]*) return 1 ;; *) return 0 ;; esac; }

check_tags=0
if ! override_set TAG && "$HOOK_DIR/../bin/tack" status --quiet; then
  check_tags=1
fi

tag_error() {
  cat >&2 <<EOF
pre-push: $1
Release tags are annotated vX.Y.Z (or vX.Y.Z-alpha.N / -beta.N / -rc.N) and never change once
published. Create one with: git tag -a v1.2.3 -m "v1.2.3"
(Deliberate override: TACK_ALLOW_TAG=1 git push ...)
EOF
  exit 1
}

while read -r _local_ref local_sha remote_ref remote_sha; do
  [ -n "${remote_ref:-}" ] || continue
  case "$remote_ref" in
    refs/tags/*)
      [ "$check_tags" -eq 1 ] || continue
      tag="${remote_ref#refs/tags/}"
      is_zero "$local_sha" && tag_error "refusing to delete the published tag '$tag' on $remote_name."
      is_zero "$remote_sha" || [ "$remote_sha" = "$local_sha" ] \
        || tag_error "refusing to move the published tag '$tag' on $remote_name."
      printf '%s\n' "$tag" | grep -qE '^v[0-9]+\.[0-9]+\.[0-9]+(-(alpha|beta|rc)\.[0-9]+)?$' \
        || tag_error "tag '$tag' doesn't follow the release convention."
      [ "$(git cat-file -t "$local_sha" 2>/dev/null)" = "tag" ] \
        || tag_error "tag '$tag' is lightweight; release tags must be annotated."
      continue
      ;;
    refs/heads/main | refs/heads/master)
      ! override_set FORCE_PUSH || continue
      ;;
    *) continue ;;
  esac
  branch="${remote_ref#refs/heads/}"

  if is_zero "$local_sha"; then
    echo "pre-push: refusing to delete '$branch' on $remote_name." >&2
    exit 1
  fi
  # A new branch on the remote is fine
  is_zero "$remote_sha" && continue

  # The push must be a fast-forward: the remote tip must be an ancestor of what we push.
  # If we don't even have the remote tip locally, the push would overwrite unknown commits.
  if ! git cat-file -e "${remote_sha}^{commit}" 2>/dev/null \
    || ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    cat >&2 <<EOF
pre-push: refusing to rewrite '$branch' on $remote_name (not a fast-forward).
Rewriting the history of $branch can destroy other people's work.
Use 'git revert' to undo published commits, or pull/rebase your local changes first.
(Deliberate override: TACK_ALLOW_FORCE_PUSH=1 git push ...)
EOF
    exit 1
  fi
done < "$stdin_file"

HARNESS_HOOK_STDIN_FILE="$stdin_file" run_local_hook pre-push "$@"
