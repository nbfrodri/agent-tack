#!/usr/bin/env bash
# Global commit-msg hook:
#   1. removes AI attribution (Co-Authored-By trailers of AI tools, "Generated with ..." lines),
#      in every repository
#   2. enforces Conventional Commits on the subject line, in projects where the harness is
#      enabled (`harness enable`)
#   3. runs the repository's own commit-msg hook, if any
#
# Opt out of the format check in an enabled repository that uses other conventions:
#   harness config conventional-commits false   (git key: harness.conventionalCommits)
set -u

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=SCRIPTDIR/_chain
. "$HOOK_DIR/_chain"

msg_file="$1"
[ -f "$msg_file" ] || exit 0

# 1. Strip AI attribution: Co-authored-by trailers whose name is exactly an AI tool or whose
#    email is an AI vendor's, and the "Generated with <tool>" footer. The subject line and any
#    other text are never touched.
tmp="$(mktemp "${TMPDIR:-/tmp}/commit-msg.XXXXXX")" || exit 1
awk '
  function is_attribution(line,   s) {
    s = tolower(line)
    if (s ~ /^[[:space:]]*co-authored-by:/) {
      if (s ~ /<[^>]*@(anthropic\.com|openai\.com|cursor\.com)>/) return 1
      return s ~ /^[[:space:]]*co-authored-by:[[:space:]]*(claude|claude code|claude [a-z]+( [0-9.]+)?|codex|chatgpt|copilot|github copilot|cursor agent|gemini|gemini code assist|aider|windsurf)[[:space:]]*</
    }
    return s ~ /^[[:space:]]*(🤖[[:space:]]*)?generated (with|by) \[?(claude code|claude|codex|chatgpt|github copilot|copilot|cursor|gemini|aider|windsurf)\]?(\(https?:[^)]*\))?[[:space:]]*\.?[[:space:]]*$/
  }
  !in_body { print; if ($0 !~ /^[[:space:]]*(#|$)/) in_body = 1; next }
  /^#/ { print; next }
  is_attribution($0) { next }
  { print }
' "$msg_file" > "$tmp"
if ! cmp -s "$tmp" "$msg_file"; then
  # Drop trailing blank lines left behind by removed trailers
  awk '{ lines[NR] = $0 } END { n = NR; while (n > 0 && lines[n] ~ /^[[:space:]]*$/) n--; for (i = 1; i <= n; i++) print lines[i] }' \
    "$tmp" > "$msg_file"
  echo "commit-msg: removed AI attribution lines from the commit message" >&2
fi
rm -f "$tmp"

# 2. Conventional Commits check on the subject (first non-comment, non-empty line)
if "$HOOK_DIR/../bin/harness" status --quiet \
  && [ "$(git config --bool harness.conventionalCommits 2>/dev/null)" != "false" ]; then
  subject="$(grep -vE '^[[:space:]]*(#|$)' "$msg_file" | head -n 1)"
  CC_PATTERN='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9._/-]+\))?!?: [^[:space:]].*'
  # Messages git or tools generate (merges, reverts, autosquash) are always accepted
  GENERATED_PATTERN='^(Merge |Revert "|fixup! |squash! |amend! |Initial commit$)'

  if [ -z "$subject" ]; then
    : # empty message: git aborts the commit itself
  elif printf '%s' "$subject" | grep -qE "$GENERATED_PATTERN"; then
    :
  elif ! printf '%s' "$subject" | grep -qE "$CC_PATTERN"; then
    cat >&2 <<EOF
commit-msg: the subject line does not follow Conventional Commits:

    $subject

Expected:  <type>(<optional scope>): <description>
Types:     feat fix docs style refactor perf test build ci chore revert
Examples:  feat(auth): add password reset
           fix: handle empty cart on checkout

(In a repository with other conventions: harness config conventional-commits false)
EOF
    exit 1
  elif [ "${#subject}" -gt 100 ]; then
    echo "commit-msg: the subject line is ${#subject} characters; keep it under 72 (max 100)." >&2
    exit 1
  fi
fi

# 3. The repository's own commit-msg hook
run_local_hook commit-msg "$@"
