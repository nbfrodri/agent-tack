#!/usr/bin/env bash
# tack: manage the workflow, its mode and formatter trust for Git projects.
set -u

usage() {
  cat <<'HELP'
Usage: tack [command] [options]

Manage the workflow, its mode and local formatter trust for the current Git project.
Default command: status

Commands:
  status [--quiet]     Show workflow activation, mode and local formatter trust
  mode [MODE] [--global|--shared]
                      Show the effective mode, or set it for this project
                      (or as the global default with --global)
  mode --unset [--global|--shared]
                      Remove the project (or global) mode setting
  mode list           List built-in and user modes with when to use each
  mode show           Print the effective mode's rules (auto: the modes to pick from)
  mode new NAME --from MODE
                      Create a user mode in ~/.config/agent-tack/modes/
                      from an existing one, to edit and select
  config [NAME [VALUE]] [--global|--shared] [--get|--json]
                      List feature toggles, show one, or set it for this project
                      (or user-wide with --global); config NAME --unset removes it
                      --get prints a raw value; --json adds source and sharing metadata
                      reply-style: brief (default), visual or detailed
  config --shared --apply FILE [--dry-run]
                      Merge selected tack.json preferences and mode in one write;
                      --dry-run previews values and local overrides without changes
  enable [--shared] [--scaffold]
                      Enable this clone, or use a shareable .tack marker;
                      --scaffold adds four evidence-based guidance files (never overwrites)
  setup [--check|--json]
                      Inspect project foundations without running project code;
                      --check exits 1 for incomplete or broken base guidance
  bootstrap [--source URL] [--revision COMMIT] [--directory PATH] [--dry-run]
                      Create optional collaborator setup files pinned to a tack commit;
                      generation does not install, activate or trust anything
  verify [--plan] [--json] [--base REF] [--budget-seconds N]
                      Select checks for changed paths; execute only with local trust
                      --plan is read-only; report failures and verification gaps
  disable             Disable this clone and remove the shared marker
  migrate             Move settings and the marker from the former harness name to tack
                      (this clone and user-wide); tack doctor says when it is needed
  trust [--revoke]     Allow or revoke project formatter execution in this clone
  trusted [--quiet]    Query local formatter trust independently of activation
  doctor              Diagnose installation and project state without changes
  models [TIER]       The model each tool uses for a tier (economical, balanced,
                      strongest), from model-tiers.txt and your own overrides
  lesson note KEY TEXT | contradict KEY | forget KEY | list   [--global]
                      Count corrections not yet saved as rules; list marks
                      the ones seen often enough to ask about (lessons skill)
  memory [show | add TEXT | path]
                      Notes about you shared by Claude Code and Codex, loaded at
                      session start (refuses secrets; edit the file to remove)
  shots [--before|--after] [--name NAME] URL... | --index | --dir
                      Screenshots of a visual change at mobile and desktop widths,
                      side by side in .tack-screenshots/ (needs Playwright)
  trace [PLAN]        Check that every requirement the plan numbers (R1, R2…) has
                      a test naming it (default: newest file in plans-path);
                      text links only, not test execution; exits 1 for missing links
  log [N]             Print the last N (default 20) activity log entries; turn the
                      log on with: tack config activity-log true
  log --cost|--skills|--levels [--days N] [--csv]
                      Summarise the last N days (default 30): tokens and USD per
                      day, project, tool and model; skill and agent use; the
                      workflow level stated per task
  context             Print project instructions plus an index (or, in strict
                      mode, excerpts) of architecture and the active handoff
  help                Show this help (also works outside a Git repository)

Global options:
  -h, --help          Show this help

Command options:
  --quiet             Suppress output for status or trusted; preserve exit codes
  --shared            enable: commit a .tack marker; mode/config: write tack.json
  --revoke            Revoke local formatter trust without disabling the workflow
  --tools             With doctor: check each installed AI tool (version, capabilities, smoke check)
  --global            Read or write the user's default instead of the project's
  --unset             Remove a mode or config setting so the next level applies

Modes:
  auto                Default: the assistant picks lite, standard or strict per task
  lite                Branch, Conventional Commits and tests; no plans, handoffs or logs
  standard            Adds TDD, a short plan and docs when behaviour changes
  strict              The full workflow: plans, handoffs, AI log, reviews, delegation

Exit codes:
  status              0 if enabled, 1 if disabled; independent of formatter trust
  trusted             0 if locally trusted, 1 otherwise
  doctor              0 if checked components are healthy, 1 if broken
  help                0; invalid commands or arguments return 2

Examples:
  tack enable
  tack status
  tack mode lite --global
  tack mode strict
  tack config
  tack config delegation off
  tack trust
  tack trusted --quiet
  tack trust --revoke
  tack doctor
  tack doctor --tools
  tack help

Formatter execution requires both activation and local trust. Trust applies only
to Claude Code's automatic formatter hook; it is not a general command permission.
HELP
}

repo_root() { git rev-parse --show-toplevel 2>/dev/null; }

fail() { printf 'tack: %s\n' "$1" >&2; exit 1; }
require_repo() { root="$(repo_root)" || { echo "tack: not inside a git repository" >&2; exit 2; }; }
check_args() {
  [ "$#" -eq 0 ] && return 0
  [ "$#" -eq 1 ] && [ "$1" = "$allowed_option" ] && return 0
  echo "tack: unsupported arguments for $cmd (see --help)" >&2
  exit 2
}
tack_root() {
  local script="${BASH_SOURCE[0]}" dir target
  while [ -L "$script" ]; do
    dir="$(cd "$(dirname "$script")" && pwd)" || return 1
    target="$(readlink "$script")" || return 1
    case "$target" in /*) script="$target" ;; *) script="$dir/$target" ;; esac
  done
  cd "$(dirname "$script")/.." && pwd
}

# Enabled when the repo has a .tack file, or tack.enabled is true
# (local, or global to enable it everywhere). An explicit local false wins over the file.
is_enabled() {
  local root setting
  root="$(repo_root)" || return 1
  [ -n "$root" ] || return 1
  setting="$(key_get --bool enabled || true)"
  [ "$setting" = "false" ] && return 1
  [ "$setting" = "true" ] && return 0
  [ -f "$root/.tack" ]
}

TACK_ROOT="$(tack_root)" || fail "cannot locate the tack checkout"
# shellcheck source=SCRIPTDIR/../lib/keys.sh
. "$TACK_ROOT/lib/keys.sh"
# shellcheck source=SCRIPTDIR/../lib/modes.sh
. "$TACK_ROOT/lib/modes.sh"

is_trusted() {
  [ "$(key_get --bool local trusted)" = true ]
}

cmd="${1:-status}"
[ $# -gt 0 ] && shift

case "$cmd" in
  enable)
    shared=0 scaffold=0
    for arg in "$@"; do
      case "$arg" in
        --shared) shared=1 ;;
        --scaffold) scaffold=1 ;;
        *) echo "tack: unsupported arguments for enable (see --help)" >&2; exit 2 ;;
      esac
    done
    require_repo
    if [ "$shared" -eq 1 ] && { [ -L "$root/.tack" ] || { [ -e "$root/.tack" ] && [ ! -f "$root/.tack" ]; }; }; then
      fail 'shared marker is a symlink or not a regular file; left untouched'
    fi
    if [ "$scaffold" -eq 1 ]; then
      bash "$TACK_ROOT/lib/scaffold.sh" "$TACK_ROOT" "$root" || fail "cannot create the docs structure"
    fi
    if [ "$shared" -eq 1 ]; then
      if [ ! -f "$root/.tack" ]; then
        printf '# This project uses the tack workflow (https://github.com/nbfrodri/agent-tack).\n' > "$root/.tack" \
          || fail "cannot write the shared marker"
      fi
      if key_scope local enabled; then
        key_unset local enabled || fail "cannot clear local activation"
      fi
      echo "Enabled through $root/.tack — commit it to share it."
    else
      key_set local enabled true || fail "cannot enable this clone"
      echo "Enabled for this clone (git config tack.enabled true)."
    fi
    echo 'Project setup: run tack setup; the assistant will propose optional additions for your selection. Use tack config setup-review deferred to postpone.'
    # The test gate before stopping runs project code, so it waits for the user's trust.
    detected="$(bash "$TACK_ROOT/lib/test-command.sh" "$TACK_ROOT" "$root")"
    if [ -z "$detected" ]; then
      echo "No test command found: name one with tack config check-fast \"<command>\" so tests run before the assistant stops."
    elif ! is_trusted; then
      printf 'Tests: %s (from %s). Run tack trust to have them run before the assistant stops.\n' \
        "${detected%%$'\t'*}" "${detected#*$'\t'}"
    fi
    ;;
  disable)
    allowed_option=''; check_args "$@"
    require_repo
    key_set local enabled false || fail "cannot disable this clone"
    if [ -f "$root/.tack" ]; then
      rm -f "$root/.tack" || fail "cannot remove the shared marker"
      echo "Removed $root/.tack — commit the removal to share it."
    fi
    echo "Disabled for this clone."
    ;;
  migrate)
    allowed_option=''; check_args "$@"
    # Settings and markers under the former name: a tack setting already present wins, as when
    # reading. The former names stop being read in a later release.
    migrated=0
    for scope in global local; do
      if [ "$scope" = local ] && ! root="$(repo_root)"; then continue; fi
      # Git values may contain whitespace and newlines. Read the last value of each key as
      # a NUL-delimited record, matching key_get, and preserve valueless booleans as true.
      while IFS= read -r former; do
        [ -n "$former" ] || continue
        current="tack.${former#harness.}"
        if ! git config "--$scope" --get "$current" >/dev/null 2>&1; then
          IFS= read -r -d '' value < <(git config "--$scope" --null --get "$former") \
            || fail "cannot read $former"
          if [ -z "$value" ] && [ "$(git config "--$scope" --bool --get "$former" 2>/dev/null)" = true ]; then
            value=true
          fi
          git config "--$scope" "$current" "$value" || fail "cannot write $current"
        fi
        migrated=1
      done < <(git config "--$scope" --name-only --get-regexp '^harness\.' 2>/dev/null | sort -u)
      if git config "--$scope" --get-regexp '^harness\.' >/dev/null 2>&1; then
        git config "--$scope" --remove-section harness || fail "cannot remove the former $scope harness settings"
        echo "Moved the $scope harness.* settings to tack.*."
      fi
      # The lean mode was merged into lite.
      if [ "$(git config "--$scope" --get tack.mode 2>/dev/null)" = lean ]; then
        git config "--$scope" tack.mode lite || fail "cannot rewrite the $scope mode"
        echo "Replaced the $scope mode lean, now part of lite, with lite."
        migrated=1
      fi
    done
    if root="$(repo_root)" && [ -f "$root/.harness" ]; then
      if [ -f "$root/.tack" ]; then rm -f "$root/.harness"; else mv "$root/.harness" "$root/.tack"; fi \
        || fail "cannot replace $root/.harness"
      echo "Replaced $root/.harness with .tack — commit the change to share it."
      migrated=1
    fi
    [ "$migrated" -eq 1 ] || echo "Nothing to migrate: only tack names are in use."
    ;;
  status)
    allowed_option=--quiet; check_args "$@"
    if is_enabled; then
      workflow_state=enabled; workflow_exit=0
    else
      workflow_state=disabled; workflow_exit=1
    fi
    if [ "${1:-}" != --quiet ]; then
      printf '%s\n' "$workflow_state"
      printf 'mode: %s\n' "$(effective_mode)"
      if is_trusted; then echo 'formatter trust: trusted'
      else echo 'formatter trust: untrusted'; fi
      if root="$(repo_root)" && detected="$(bash "$TACK_ROOT/lib/test-command.sh" "$TACK_ROOT" "$root")" && [ -n "$detected" ]; then
        printf 'test command: %s (from %s)
' "${detected%%$'	'*}" "${detected#*$'	'}"
      else
        echo 'test command: none found (set one with tack config check-fast)'
      fi
    fi
    exit "$workflow_exit"
    ;;
  mode)
    case "${1:-}" in
      list)
        [ "$#" -eq 1 ] || { echo "tack: mode list takes no arguments" >&2; exit 2; }
        list_modes
        exit 0
        ;;
      show)
        [ "$#" -eq 1 ] || { echo "tack: mode show takes no arguments" >&2; exit 2; }
        show_mode
        exit 0
        ;;
      new)
        if [ "$#" -ne 4 ] || [ "$3" != --from ]; then
          echo "tack: usage: tack mode new NAME --from MODE" >&2; exit 2
        fi
        new_mode "$2" "$4"
        exit
        ;;
    esac
    scope=local value='' unset=false
    for arg in "$@"; do
      case "$arg" in
        --global)
          [ "$scope" != shared ] || { echo 'tack: --shared and --global conflict' >&2; exit 2; }
          scope=global ;;
        --shared)
          [ "$scope" != global ] || { echo 'tack: --shared and --global conflict' >&2; exit 2; }
          scope=shared ;;
        --unset) unset=true ;;
        *)
          if [ -z "$value" ] && is_mode "$arg"; then value="$arg"
          else echo "tack: unsupported arguments for mode (see --help)" >&2; exit 2; fi
          ;;
      esac
    done
    if [ "$unset" = true ] && [ -n "$value" ]; then
      echo "tack: --unset takes no mode (see --help)" >&2; exit 2
    fi
    if [ "$unset" = false ] && [ -z "$value" ]; then
      if [ "$scope" != local ]; then effective_mode "$scope"; else effective_mode; fi
      exit
    fi
    if [ "$scope" = shared ]; then
      require_repo
      if [ "$unset" = true ]; then shared_value=--unset; else shared_value="$value"; fi
      python3 "$TACK_ROOT/lib/project_config.py" "$TACK_ROOT" shared-mode "$shared_value" || exit $?
      echo "Shared mode updated; effective mode: $(effective_mode)."
      exit 0
    fi
    if [ "$scope" = global ] && [ -n "$value" ] && is_project_only "$value"; then
      echo "tack: $value is project-only; select it inside each project instead" >&2; exit 2
    fi
    [ "$scope" = global ] || require_repo
    if [ "$scope" = local ] && [ -n "$value" ] && is_project_only "$value"; then
      case "$(git branch --show-current 2>/dev/null)" in
        main | master) echo "tack: $value runs without confirmations; switch to a branch or worktree first" >&2; exit 2 ;;
      esac
    fi
    if [ "$unset" = true ]; then
      if key_scope "$scope" mode; then
        key_unset "$scope" mode || fail "cannot unset the $scope mode"
      fi
      echo "Removed the $scope mode; effective mode: $(effective_mode)."
    else
      key_set "$scope" mode "$value" || fail "cannot set the $scope mode"
      echo "Mode set to $value ($scope); effective mode: $(effective_mode)."
    fi
    ;;
  trust)
    allowed_option=--revoke; check_args "$@"
    require_repo
    if [ "${1:-}" = --revoke ]; then
      key_set local trusted false || fail "cannot revoke local trust"
      echo "Project formatter execution trust revoked for this clone."
    else
      key_set local trusted true || fail "cannot trust this clone"
      echo "Project formatter execution trusted for this clone."
    fi
    ;;
  trusted)
    allowed_option=--quiet; check_args "$@"
    if is_trusted; then
      [ "${1:-}" = --quiet ] || echo trusted
      exit 0
    fi
    [ "${1:-}" = --quiet ] || echo untrusted
    exit 1
    ;;
  setup)
    case "$#:${1:-}" in 0: | 1:--check | 1:--json) ;; *) echo 'tack: usage: tack setup [--check|--json]' >&2; exit 2 ;; esac
    require_repo
    command -v python3 >/dev/null 2>&1 || fail 'setup needs python3'
    python3 "$TACK_ROOT/lib/project_setup.py" "$root" "$@"
    exit
    ;;
  bootstrap)
    require_repo
    command -v python3 >/dev/null 2>&1 || fail 'bootstrap needs python3'
    python3 "$TACK_ROOT/lib/project_bootstrap.py" "$root" "$@"
    exit
    ;;
  verify)
    require_repo
    command -v python3 >/dev/null 2>&1 || fail 'verify needs python3'
    TACK_VERIFY_TRUSTED=0
    is_trusted && TACK_VERIFY_TRUSTED=1
    TACK_VERIFY_BASH="$BASH"
    if command -v cygpath >/dev/null 2>&1; then TACK_VERIFY_BASH="$(cygpath -m "$BASH")"; fi
    export TACK_VERIFY_TRUSTED TACK_VERIFY_BASH
    python3 "$TACK_ROOT/lib/verification.py" "$root" "$TACK_ROOT" "$@"
    exit
    ;;
  context)
    allowed_option=''; check_args "$@"
    is_enabled || exit 0
    context_enabled="$(bash "$TACK_ROOT/lib/config.sh" "$TACK_ROOT" context --get)" || exit 2
    [ "$context_enabled" != false ] || exit 0
    root="$(repo_root)" || exit 0
    source_root="$TACK_ROOT"
    case "$(key_get setupReview)" in
      done | deferred) ;;
      *) echo 'Project setup review pending: when initializing or asked to configure the project, run tack setup and follow new-project -> references/onboarding.md; ask which optional files to add and remember choices. For focused tasks, reuse existing guidance and postpone unrelated setup unless it blocks the task. Read-only requests stay read-only.' ;;
    esac
    bash "$source_root/lib/project-context.sh" "$root" "$(context_level)"
    if [ -e "$root/checks-map.json" ] || [ -L "$root/checks-map.json" ]; then
      echo 'Project verification: tack verify selects checks from checks-map.json for changed paths. Use --plan for read-only selection; report failures and unmapped paths. Execution needs local trust.'
      exit 0
    fi
    detected="$(bash "$source_root/lib/test-command.sh" "$source_root" "$root")"
    [ -z "$detected" ] || printf '
Test command: %s (from %s). Use it to verify changes instead of searching for one.
'       "${detected%%$'	'*}" "${detected#*$'	'}"
    ;;
  config)
    source_root="$TACK_ROOT"
    bash "$source_root/lib/config.sh" "$source_root" "$@"
    exit
    ;;
  log)
    report='' days='' csv=0 count=''
    log_usage() { echo "tack: $1 (see --help)" >&2; exit 2; }
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --cost | --skills | --levels) [ -z "$report" ] || log_usage 'log takes one report'; report="${1#--}" ;;
        --csv) csv=1 ;;
        --days) days="${2:-}"; [ "$#" -gt 1 ] && shift ;;
        -*) log_usage "unknown option for log: $1" ;;
        *) [ -z "$count" ] || log_usage 'log takes one number of entries'; count="$1" ;;
      esac
      shift
    done
    # A count belongs to the plain listing; --days and --csv to a report.
    if [ -n "$report" ]; then
      [ -z "$count" ] || log_usage 'a number of entries does not apply to a report; use --days'
    else
      if [ "$csv" -eq 1 ] || [ -n "$days" ]; then log_usage '--csv and --days need --cost, --skills or --levels'; fi
    fi
    count="${count:-20}" days="${days:-30}"
    if ! printf '%s' "$count" | grep -qE '^[1-9][0-9]*$' || ! printf '%s' "$days" | grep -qE '^[1-9][0-9]*$'; then
      log_usage 'log takes a positive number of entries, and --days a positive number of days'
    fi
    log_file="${XDG_STATE_HOME:-$HOME/.local/state}/agent-tack/activity.log"
    if [ ! -s "$log_file" ]; then
      echo "No activity recorded. Turn the log on with: tack config activity-log true"
      exit 0
    fi
    if [ -z "$report" ]; then
      tail -n "$count" "$log_file"
      exit 0
    fi
    command -v python3 >/dev/null 2>&1 || fail "log reports need python3"
    python3 "$TACK_ROOT/lib/log-report.py" "$report" "$log_file" "$days" "$csv" \
      "${XDG_CONFIG_HOME:-$HOME/.config}/agent-tack/pricing.txt" "$TACK_ROOT"
    ;;
  models)
    [ "$#" -le 1 ] || { echo "tack: models takes at most one tier (see --help)" >&2; exit 2; }
    bash "$TACK_ROOT/lib/models.sh" "$TACK_ROOT" "$@"
    exit
    ;;
  lesson)
    bash "$TACK_ROOT/lib/lessons.sh" "$@"
    exit
    ;;
  memory)
    bash "$TACK_ROOT/lib/memory.sh" "$TACK_ROOT" "$@"
    exit
    ;;
  shots)
    bash "$TACK_ROOT/lib/shots.sh" "$TACK_ROOT" "$@"
    exit
    ;;
  trace)
    [ "$#" -le 1 ] || { echo "tack: trace takes at most one plan (see --help)" >&2; exit 2; }
    bash "$TACK_ROOT/lib/trace.sh" "$@"
    exit
    ;;
  doctor)
    allowed_option='--tools'; check_args "$@"
    source_root="$TACK_ROOT"
    bash "$source_root/lib/doctor.sh" "$source_root" "$@"
    ;;
  -h|--help|help)
    allowed_option=''; check_args "$@"
    usage
    ;;
  *)
    echo "tack: unknown command '$cmd'" >&2
    usage >&2
    exit 2
    ;;
esac
