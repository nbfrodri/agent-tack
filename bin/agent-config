#!/usr/bin/env bash
# Turns the full agent-config workflow on or off for the current git repository.
#
#   agent-config enable           enable for this clone only (stored in .git/config, invisible to others)
#   agent-config enable --shared  enable through a committed .agent-config file (travels with the repo)
#   agent-config disable          disable (removes both markers)
#   agent-config status           print whether it is enabled; exit 0 if enabled, 1 if not
#   agent-config status --quiet   same, without output (used by hooks)
#
# Outside enabled projects only the safety net stays active: the command guard, the protection
# of main and the removal of AI attribution from commit messages.
set -u

usage() { sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; }

repo_root() { git rev-parse --show-toplevel 2>/dev/null; }

# Enabled when the repo has a .agent-config file, or git config agentconfig.enabled is true
# (local, or global to enable it everywhere). An explicit local false wins over the file.
is_enabled() {
  local root setting
  root="$(repo_root)" || return 1
  [ -n "$root" ] || return 1
  setting="$(git config --bool --get agentconfig.enabled 2>/dev/null || true)"
  [ "$setting" = "false" ] && return 1
  [ "$setting" = "true" ] && return 0
  [ -f "$root/.agent-config" ]
}

cmd="${1:-status}"
[ $# -gt 0 ] && shift

case "$cmd" in
  enable)
    root="$(repo_root)" || { echo "agent-config: not inside a git repository" >&2; exit 2; }
    git config --unset agentconfig.enabled 2>/dev/null
    if [ "${1:-}" = "--shared" ]; then
      printf '# This project uses the agent-config workflow (https://github.com/nbfrodri/agent-config).\n' > "$root/.agent-config"
      echo "Enabled through $root/.agent-config — commit it to share it."
    else
      git config agentconfig.enabled true
      echo "Enabled for this clone (git config agentconfig.enabled true)."
    fi
    ;;
  disable)
    root="$(repo_root)" || { echo "agent-config: not inside a git repository" >&2; exit 2; }
    if [ -f "$root/.agent-config" ]; then
      rm -f "$root/.agent-config"
      echo "Removed $root/.agent-config — commit the removal to share it."
    fi
    git config agentconfig.enabled false
    echo "Disabled for this clone."
    ;;
  status)
    if is_enabled; then
      [ "${1:-}" = "--quiet" ] || echo "enabled"
      exit 0
    fi
    [ "${1:-}" = "--quiet" ] || echo "disabled"
    exit 1
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    echo "agent-config: unknown command '$cmd'" >&2
    usage >&2
    exit 2
    ;;
esac
