#!/usr/bin/env bash
# Deprecated alias for `tack`, kept so scripts and other machines keep working after the rename.
script="${BASH_SOURCE[0]}"
while [ -L "$script" ]; do
  dir="$(cd "$(dirname "$script")" && pwd)" || exit 1
  target="$(readlink "$script")" || exit 1
  case "$target" in /*) script="$target" ;; *) script="$dir/$target" ;; esac
done
# Only people see the notice; hooks and scripts get the same output as before.
[ ! -t 2 ] || printf 'harness: renamed to tack; this alias will be removed in a later release\n' >&2
exec "$(cd "$(dirname "$script")" && pwd)/tack" "$@"
