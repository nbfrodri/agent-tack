#!/usr/bin/env bash
# Manage the agent-harness workflow, its mode and formatter trust for Git projects.
set -u

usage() {
  cat <<'HELP'
Usage: harness [command] [options]

Manage the workflow, its mode and local formatter trust for the current Git project.
Default command: status

Commands:
  status [--quiet]     Show workflow activation, mode and local formatter trust
  mode [MODE] [--global]
                      Show the effective mode, or set it for this project
                      (or as the global default with --global)
  mode --unset [--global]
                      Remove the project (or global) mode setting
  config [NAME [VALUE]] [--global]
                      List feature toggles, show one, or set it for this project
                      (or user-wide with --global); config NAME --unset removes it
  enable [--shared]    Enable this clone, or use a shareable .harness marker
  disable             Disable this clone and remove the shared marker
  trust [--revoke]     Allow or revoke project formatter execution in this clone
  trusted [--quiet]    Query local formatter trust independently of activation
  doctor              Diagnose installation and project state without changes
  context             Print project instructions plus an index (or, in strict
                      mode, excerpts) of architecture and the active handoff
  help                Show this help (also works outside a Git repository)

Global options:
  -h, --help          Show this help

Command options:
  --quiet             Suppress output for status or trusted; preserve exit codes
  --shared            Enable with a .harness file you can commit and share
  --revoke            Revoke local formatter trust without disabling the workflow
  --global            Read or write the user's default instead of the project's
  --unset             Remove a mode or config setting so the next level applies

Modes:
  auto                Default: the assistant picks lite, standard or strict per task
  lite                Branch, Conventional Commits and tests; no plans, handoffs or logs
  standard            Adds TDD, a short plan and docs when behaviour changes
  strict              The full workflow: plans, handoffs, AI log, reviews, delegation

Exit codes:
  status              0 if enabled, 1 if disabled; independent of formatter trust
  trusted             0 if locally trusted, 1 otherwise
  doctor              0 if checked components are healthy, 1 if broken
  help                0; invalid commands or arguments return 2

Examples:
  harness enable
  harness status
  harness mode lite --global
  harness mode strict
  harness config
  harness config delegation off
  harness trust
  harness trusted --quiet
  harness trust --revoke
  harness doctor
  harness help

Formatter execution requires both activation and local trust. Trust applies only
to Claude Code's automatic formatter hook; it is not a general command permission.
HELP
}

repo_root() { git rev-parse --show-toplevel 2>/dev/null; }

fail() { printf 'harness: %s\n' "$1" >&2; exit 1; }
require_repo() { root="$(repo_root)" || { echo "harness: not inside a git repository" >&2; exit 2; }; }
check_args() {
  [ "$#" -eq 0 ] && return 0
  [ "$#" -eq 1 ] && [ "$1" = "$allowed_option" ] && return 0
  echo "harness: unsupported arguments for $cmd (see --help)" >&2
  exit 2
}
harness_root() {
  local script="${BASH_SOURCE[0]}" dir target
  while [ -L "$script" ]; do
    dir="$(cd "$(dirname "$script")" && pwd)" || return 1
    target="$(readlink "$script")" || return 1
    case "$target" in /*) script="$target" ;; *) script="$dir/$target" ;; esac
  done
  cd "$(dirname "$script")/.." && pwd
}

# Enabled when the repo has a .harness file, or git config harness.enabled is true
# (local, or global to enable it everywhere). An explicit local false wins over the file.
is_enabled() {
  local root setting
  root="$(repo_root)" || return 1
  [ -n "$root" ] || return 1
  setting="$(git config --bool --get harness.enabled 2>/dev/null || true)"
  [ "$setting" = "false" ] && return 1
  [ "$setting" = "true" ] && return 0
  [ -f "$root/.harness" ]
}

is_mode() {
  case "$1" in auto | lite | standard | strict) return 0 ;; *) return 1 ;; esac
}

# Prints the effective mode and where it comes from: a project setting wins over the
# user's global default. Invalid values behave as auto so a typo never blocks work.
effective_mode() {
  local scope value
  [ "$#" -gt 0 ] || set -- local global
  for scope in "$@"; do
    value="$(git config "--$scope" --get harness.mode 2>/dev/null)" || continue
    if is_mode "$value"; then printf '%s (%s)\n' "$value" "$scope"
    else printf 'auto (invalid %s value: %s)\n' "$scope" "$value"; fi
    return
  done
  echo 'auto (default)'
}

is_trusted() {
  [ "$(git config --local --bool --get harness.trusted 2>/dev/null)" = true ]
}

cmd="${1:-status}"
[ $# -gt 0 ] && shift

case "$cmd" in
  enable)
    allowed_option=--shared; check_args "$@"
    require_repo
    if [ "${1:-}" = "--shared" ]; then
      printf '# This project uses the agent-harness workflow (https://github.com/nbfrodri/agent-harness).\n' > "$root/.harness" \
        || fail "cannot write the shared marker"
      if git config --local --get harness.enabled >/dev/null 2>&1; then
        git config --local --unset-all harness.enabled || fail "cannot clear local activation"
      fi
      echo "Enabled through $root/.harness — commit it to share it."
    else
      git config --local harness.enabled true || fail "cannot enable this clone"
      echo "Enabled for this clone (git config harness.enabled true)."
    fi
    ;;
  disable)
    allowed_option=''; check_args "$@"
    require_repo
    git config --local harness.enabled false || fail "cannot disable this clone"
    if [ -f "$root/.harness" ]; then
      rm -f "$root/.harness" || fail "cannot remove the shared marker"
      echo "Removed $root/.harness — commit the removal to share it."
    fi
    echo "Disabled for this clone."
    ;;
  status)
    allowed_option=--quiet; check_args "$@"
    if is_enabled; then
      workflow_state=enabled; workflow_exit=0
    else
      workflow_state=disabled; workflow_exit=1
    fi
    if [ "${1:-}" != --quiet ]; then
      printf '%s\n' "$workflow_state"
      printf 'mode: %s\n' "$(effective_mode)"
      if is_trusted; then echo 'formatter trust: trusted'
      else echo 'formatter trust: untrusted'; fi
    fi
    exit "$workflow_exit"
    ;;
  mode)
    scope=local value='' unset=false
    for arg in "$@"; do
      case "$arg" in
        --global) scope=global ;;
        --unset) unset=true ;;
        *)
          if [ -z "$value" ] && is_mode "$arg"; then value="$arg"
          else echo "harness: unsupported arguments for mode (see --help)" >&2; exit 2; fi
          ;;
      esac
    done
    if [ "$unset" = true ] && [ -n "$value" ]; then
      echo "harness: --unset takes no mode (see --help)" >&2; exit 2
    fi
    if [ "$unset" = false ] && [ -z "$value" ]; then
      if [ "$scope" = global ]; then effective_mode global; else effective_mode; fi
      exit 0
    fi
    [ "$scope" = global ] || require_repo
    if [ "$unset" = true ]; then
      if git config "--$scope" --get harness.mode >/dev/null 2>&1; then
        git config "--$scope" --unset-all harness.mode || fail "cannot unset the $scope mode"
      fi
      echo "Removed the $scope mode; effective mode: $(effective_mode)."
    else
      git config "--$scope" harness.mode "$value" || fail "cannot set the $scope mode"
      echo "Mode set to $value ($scope); effective mode: $(effective_mode)."
    fi
    ;;
  trust)
    allowed_option=--revoke; check_args "$@"
    require_repo
    if [ "${1:-}" = --revoke ]; then
      git config --local harness.trusted false || fail "cannot revoke local trust"
      echo "Project formatter execution trust revoked for this clone."
    else
      git config --local harness.trusted true || fail "cannot trust this clone"
      echo "Project formatter execution trusted for this clone."
    fi
    ;;
  trusted)
    allowed_option=--quiet; check_args "$@"
    if is_trusted; then
      [ "${1:-}" = --quiet ] || echo trusted
      exit 0
    fi
    [ "${1:-}" = --quiet ] || echo untrusted
    exit 1
    ;;
  context)
    allowed_option=''; check_args "$@"
    is_enabled || exit 0
    [ "$(git config --bool --get harness.context 2>/dev/null)" != false ] || exit 0
    root="$(repo_root)" || exit 0
    source_root="$(harness_root)" || fail "cannot locate installed context renderer"
    mode="$(effective_mode)"
    bash "$source_root/lib/project-context.sh" "$root" "${mode%% *}"
    ;;
  config)
    source_root="$(harness_root)" || fail "cannot locate the feature registry"
    bash "$source_root/lib/config.sh" "$source_root" "$@"
    exit
    ;;
  doctor)
    allowed_option=''; check_args "$@"
    source_root="$(harness_root)" || fail "cannot locate installed diagnostics"
    bash "$source_root/lib/doctor.sh" "$source_root"
    ;;
  -h|--help|help)
    allowed_option=''; check_args "$@"
    usage
    ;;
  *)
    echo "harness: unknown command '$cmd'" >&2
    usage >&2
    exit 2
    ;;
esac
